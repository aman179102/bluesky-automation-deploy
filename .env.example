# Required for live posting (use a Bluesky app password, never the account password).
BSKY_HANDLE=aman179102.bsky.social
BSKY_APP_PASSWORD=
BSKY_PDS_URL=https://bsky.social

# Optional AI providers. Without a key the deterministic template writer is used.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.6-flash
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
OPENROUTER_MODELS=openrouter/free,google/gemma-4-26b-a4b-it:free,thinkingmachines/inkling-small:free,cohere/north-mini-code:free

# Optional operational settings.
POSTING_ENABLED=true
MAX_POSTS_PER_DAY=4
MAX_BREAKING_POSTS_PER_DAY=1
MAX_BREAKING_POSTS_PER_WEEK=3
MAX_TOTAL_POSTS_PER_DAY=4
HISTORY_DAYS=30
TIMEZONE=Asia/Kolkata
NVD_API_KEY=
HEALTHCHECK_URL=
GITHUB_TOKEN=

# Viral story selection. Raise MIN_VIRALITY_SCORE to skip more niche stories.
MIN_VIRALITY_SCORE=30
VIRALITY_WEIGHT=1.6

# Human-visible auto-replies. Keep enabled only when an AI key is configured.
ENGAGEMENT_ENABLED=true
ENGAGEMENT_REQUIRE_AI=true
ENGAGEMENT_PER_RUN=1
ENGAGEMENT_DAILY_LIMIT=30
ENGAGEMENT_WEEKLY_LIMIT=210
ENGAGEMENT_AUTHOR_COOLDOWN_DAYS=7
ENGAGEMENT_MIN_LIKES=0
ENGAGEMENT_MAX_REPLIES=50
ENGAGEMENT_MAX_AGE_HOURS=48
ENGAGEMENT_TOPICS=AI, OpenAI, Google, Microsoft, Apple, cybersecurity, Linux, Python, developer tools

POST_WITH_IMAGE=false

# Server scheduler: randomized local times, 4 posts and 30 replies per day.
SCHEDULE_START=08:00
SCHEDULE_END=23:30
SCHEDULE_POSTS_PER_DAY=4
SCHEDULE_REPLIES_PER_DAY=30
SCHEDULE_POST_MIN_GAP_MINUTES=90
SCHEDULE_REPLY_MIN_GAP_MINUTES=12

# Persistent state for Render (private state repo + write-enabled deploy key).
STATE_BACKEND=local
STATE_GIT_REPO=
STATE_GIT_BRANCH=main
STATE_GIT_SSH_KEY_B64=
